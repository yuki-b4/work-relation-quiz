{
  "name": "nature-shindan",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "content": "node tools/extract-content.mjs",
    "parity": "node --experimental-strip-types tools/parity-check.mjs",
    "test:session": "node --experimental-strip-types tools/result-session-test.mjs",
    "test:markup": "node --experimental-strip-types tools/markup-check.mjs",
    "test:e2e": "bash tools/e2e-submit.sh && bash tools/e2e-result.sh",
    "check": "npm run content && npm run parity && npm run test:session && npm run test:markup && npm run typecheck",
    "db:create": "wrangler d1 create nature-shindan",
    "db:migrate:local": "wrangler d1 migrations apply nature-shindan --local",
    "db:migrate:remote": "wrangler d1 migrations apply nature-shindan --remote",
    "db:console:local": "wrangler d1 execute nature-shindan --local --command"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "typescript": "^5.7.0",
    "wrangler": "^4.128.0"
  }
}
